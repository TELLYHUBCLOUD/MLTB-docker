set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export PIP_BREAK_SYSTEM_PACKAGES=1

TEMP_DIR="$(mktemp -d)"
SDK_DIR="/home/sdk"
JDOWNLOADER_HOME="/JDownloader"
BIN_DIR="/usr/local/bin"

echo "Installing packages..."

apt-get update
apt-get install -y --no-install-recommends \
    apt-utils \
    python3.12 \
    python3.12-dev \
    libpython3.12 \
    libpython3.12-dev \
    git \
    curl \
    wget \
    gcc \
    g++ \
    make \
    cmake \
    autoconf \
    automake \
    build-essential \
    libtool \
    gettext \
    gpg-agent \
    intltool \
    swig \
    ffmpeg \
    mediainfo \
    aria2 \
    zstd \
    xz-utils \
    libmagic-dev \
    locales \
    neofetch \
    p7zip-full \
    p7zip-rar \
    tzdata \
    ca-certificates \
    procps \
    cpulimit \
    openjdk-17-jre-headless \
    unzip \
    zip \
    libcurl4-openssl-dev \
    libsodium-dev \
    libssl-dev \
    libcrypto++-dev \
    libc-ares-dev \
    libsqlite3-dev \
    libfreeimage-dev \
    libpthread-stubs0-dev \
    zlib1g-dev \
    libboost-all-dev

ln -sf /usr/bin/python3.12 /usr/bin/python3
ln -sf /usr/bin/python3.12 /usr/bin/python

curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

python3 -m pip install \
    --no-cache-dir \
    --break-system-packages \
    setuptools wheel

mv /usr/bin/ffmpeg /usr/bin/witchcraft

echo "Downloading files..."

mkdir -p \
    "$JDOWNLOADER_HOME/cfg" \
    "$JDOWNLOADER_HOME/logs" \
    "$JDOWNLOADER_HOME/update" \
    "$JDOWNLOADER_HOME/tmp" \
    "$BIN_DIR"

arch="$(uname -m)"

if [ "$arch" = "x86_64" ]; then

    wget -qO "$TEMP_DIR/qbittorrent-nox" \
    https://github.com/userdocs/qbittorrent-nox-static/releases/latest/download/x86_64-qbittorrent-nox &

    wget -qO "$TEMP_DIR/uv.tar.gz" \
    https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-gnu.tar.gz &

else

    wget -qO "$TEMP_DIR/qbittorrent-nox" \
    https://github.com/userdocs/qbittorrent-nox-static/releases/latest/download/aarch64-qbittorrent-nox &

    wget -qO "$TEMP_DIR/uv.tar.gz" \
    https://github.com/astral-sh/uv/releases/latest/download/uv-aarch64-unknown-linux-gnu.tar.gz &

fi

wget -qO "$JDOWNLOADER_HOME/JDownloader.jar" \
http://installer.jdownloader.org/JDownloader.jar &

wait

echo "Installing downloaded binaries..."

install -m 755 \
"$TEMP_DIR/qbittorrent-nox" \
"$BIN_DIR/tntengine"

tar -xzf "$TEMP_DIR/uv.tar.gz" -C "$TEMP_DIR"

install -m 755 \
"$(find "$TEMP_DIR" -name uv | head -n1)" \
/usr/bin/uv

if [ -f /usr/bin/aria2c ]; then
    mv /usr/bin/aria2c /usr/bin/intblaster
fi

echo "Installing rclone..."

curl -fsSL https://rclone.org/install.sh | bash

if [ -f /usr/bin/rclone ]; then
    mv /usr/bin/rclone /usr/bin/cloudboomer
elif [ -f /usr/local/bin/rclone ]; then
    mv /usr/local/bin/rclone /usr/local/bin/cloudboomer
fi

cd /

echo "Testing MEGA SDK..."

python3 - <<EOF
import mega
api = mega.MegaApi("test")
print("MEGA SDK Version:", api.getVersion())
EOF

echo "Installing Deno system-wide..."

# Create directory for Deno installation
DENO_DIR="/usr/local/lib/deno"
mkdir -p "$DENO_DIR"

# Install Deno to system location using DENO_INSTALL env var
export DENO_INSTALL="$DENO_DIR"
curl -fsSL https://deno.land/install.sh | sh

# Create symlink in /usr/local/bin
ln -sf "$DENO_DIR/bin/deno" /usr/local/bin/deno

# Create environment file for Deno
cat > /etc/profile.d/deno.sh << 'EOF'
export DENO_INSTALL="/usr/local/lib/deno"
export PATH="$DENO_INSTALL/bin:$PATH"
EOF
chmod +x /etc/profile.d/deno.sh

# Also add to /etc/environment for system-wide availability
echo "DENO_INSTALL=/usr/local/lib/deno" >> /etc/environment

# Verify Deno installation
if command -v deno &> /dev/null; then
    echo "Deno installed successfully: $(deno --version)"
else
    echo "Deno installation failed"
fi

echo "Cleaning..."

rm -rf "$TEMP_DIR"
rm -rf /tmp/*
rm -rf /var/tmp/*
rm -rf /var/lib/apt/lists/*

echo "Build completed successfully"
